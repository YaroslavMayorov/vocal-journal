{
  "name": "vocal-journal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api,media -c blue,green,magenta \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:media\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --local --port 8787 --var MEDIA_UPLOADS_ENABLED:true --var MEDIA_STORAGE_PROVIDER:local --var LOCAL_MEDIA_BASE_URL:http://127.0.0.1:8790",
    "dev:media": "node --env-file-if-exists=.env.local --import tsx local-media/server.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply vocal-journal --local",
    "db:migrations:list": "wrangler d1 migrations list vocal-journal --local"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "aws4fetch": "^1.0.20",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "miniflare": "^5.20261023.0-beta",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
