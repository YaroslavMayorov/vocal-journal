# Relative URLs work for a same-origin Cloudflare Pages/Workers deployment.
VITE_API_BASE_URL=/api

# Локальное хранилище. npm run dev уже передаёт provider и флаг загрузки
# локальному Worker; секрет можно переопределить одновременно для Worker и
# local-media/server.ts через .env.local.
MEDIA_STORAGE_PROVIDER=local
MEDIA_UPLOADS_ENABLED=false
LOCAL_MEDIA_BASE_URL=http://127.0.0.1:8790
LOCAL_MEDIA_SIGNING_SECRET=replace-with-a-long-random-local-secret

# Backblaze B2 S3-compatible API. Оставьте пустыми для локальной разработки.
# Храните реальные значения в .dev.vars или через `wrangler secret put`.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
